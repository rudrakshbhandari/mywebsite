{
  "name": "rudraksh-portfolio",
  "version": "1.0.0",
  "description": "Rudraksh Bhandari's personal portfolio website",
  "main": "index.html",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:html": "prettier --write *.html",
    "notes:build": "node scripts/build-notes.mjs",
    "notes:admin": "decap-server",
    "check:syntax": "sh -c 'set -- js/*.js scripts/*.mjs *.mjs; for f in \"$@\"; do [ -e \"$f\" ] || continue; node --check \"$f\"; done'",
    "ci:check": "npm run format:check && npm run check:syntax",
    "oura:token": "node scripts/get-oura-token.mjs",
    "oura:diagnose": "node scripts/diagnose-oura-api.mjs",
    "health:check-freshness": "node scripts/check-health-dashboard-freshness.mjs"
  },
  "keywords": [
    "portfolio",
    "website",
    "personal",
    "developer",
    "computer-science"
  ],
  "author": "Rudraksh Bhandari",
  "license": "MIT",
  "devDependencies": {
    "decap-server": "^3.2.0",
    "gray-matter": "^4.0.3",
    "marked": "^15.0.12",
    "prettier": "^3.0.0"
  }
}
