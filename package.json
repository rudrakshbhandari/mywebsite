{
  "name": "rudraksh-portfolio",
  "version": "1.0.0",
  "description": "Rudraksh Bhandari's personal portfolio website",
  "main": "index.html",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:html": "prettier --write *.html",
    "check:syntax": "sh -c 'for f in js/*.js scripts/*.mjs *.mjs; do node --check \"$f\"; done'",
    "ci:check": "npm run format:check && npm run check:syntax"
  },
  "keywords": [
    "portfolio",
    "website",
    "personal",
    "developer",
    "computer-science"
  ],
  "author": "Rudraksh Bhandari",
  "license": "MIT",
  "devDependencies": {
    "prettier": "^3.0.0"
  }
}
